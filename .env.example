# Growth OS — environment variable names only. NEVER commit values.
# The repository is public; gitleaks blocks a real secret at pre-commit and in CI
# (10-security-architecture.md §3).
#
# Every variable below is validated by packages/platform/config at boot. A missing or
# malformed value fails the process rather than surfacing later as a runtime surprise.

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
APP_ENV=development                  # development | test | staging | production
SERVICE_NAME=growth-os
APP_VERSION=0.0.0
LOG_LEVEL=info                       # trace | debug | info | warn | error | fatal
LOG_PRETTY=true                      # developer terminals only; production emits JSON
PORT=3000

# ---- Database ----------------------------------------------------------------
# The application connects as growth_os_app, which is NOBYPASSRLS. The migrator role is
# used ONLY by the migration job and must never appear in an application process
# (06-identity-and-access.md §4).
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---- Redis -------------------------------------------------------------------
# Queues, rate limits, locks, short-TTL caches. Never a system of record.
REDIS_URL=

# ---- Secrets (min 32 chars) --------------------------------------------------
SESSION_COOKIE_SECRET=
ENCRYPTION_MASTER_KEY=

# ---- Observability -----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
SENTRY_DSN=

# ---- Storage -----------------------------------------------------------------
STORAGE_BUCKET=
STORAGE_REGION=
# User content is served from a SEPARATE origin so a stored payload cannot reach app
# cookies (10-security-architecture.md §2).
USER_CONTENT_ORIGIN=

# ---- Client-visible (NEXT_PUBLIC_ prefix required) ---------------------------
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
