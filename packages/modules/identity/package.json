{
  "name": "@growth-os/module-identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./application": {
      "types": "./dist/application/index.d.ts",
      "import": "./dist/application/index.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure/index.d.ts",
      "import": "./dist/infrastructure/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean && rm -rf dist",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@growth-os/authn": "workspace:*",
    "@growth-os/errors": "workspace:*",
    "@growth-os/types": "workspace:*",
    "openid-client": "6.8.8"
  },
  "devDependencies": {
    "@growth-os/authz": "workspace:*",
    "@growth-os/db": "workspace:*",
    "@growth-os/module-organization": "workspace:*",
    "@growth-os/testing": "workspace:*",
    "@types/pg": "8.23.1",
    "jose": "6.2.12",
    "pg": "8.16.3",
    "vitest": "5.0.0"
  }
}
