{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".env.example"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "e2e": {
      "dependsOn": [],
      "outputs": ["playwright-report/**"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  },
  "globalEnv": [
    "CI",
    "PLAYWRIGHT_BROWSERS_PATH",
    "PLAYWRIGHT_CHROMIUM_PATH",
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD",
    "PG_BIN",
    "GROWTH_OS_MIGRATIONS_DIR"
  ]
}
