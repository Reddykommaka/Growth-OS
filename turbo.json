{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".env.example"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "e2e": {
      "dependsOn": [],
      "outputs": ["playwright-report/**"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "@growth-os/architecture-tests#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    }
  },
  "globalEnv": [
    "CI",
    "DATABASE_MIGRATOR_URL",
    "GROWTH_OS_MIGRATIONS_DIR",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_LOGS_EXPORTER",
    "OTEL_METRICS_EXPORTER",
    "OTEL_TRACES_EXPORTER",
    "PG_BIN",
    "PLAYWRIGHT_BROWSERS_PATH",
    "PLAYWRIGHT_CHROMIUM_PATH",
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD",
    "SENTRY_DSN"
  ]
}
