{
  "name": "growth-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Growth OS \u2014 multi-tenant operating system for business growth",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "tsc --build",
    "typecheck:clean": "tsc --build --clean && tsc --build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "pnpm run lint:format && pnpm run lint:code && pnpm run lint:boundaries && pnpm run lint:filesize",
    "lint:format": "biome format .",
    "lint:code": "biome lint .",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs --output-type err packages apps",
    "lint:filesize": "node tools/scripts/check-file-size.mjs apps packages",
    "format": "biome check --write .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "dependency-cruiser": "18.2.0",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "packageExtensions": {
      "dependency-cruiser": {
        "dependencies": {
          "typescript": "6.0.3"
        }
      }
    }
  }
}
